FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080 EDGE_AGENT_ENABLE_ADK=0
WORKDIR /app
RUN groupadd --gid 65532 app && useradd --uid 65532 --gid app --create-home app
COPY packages/shared-contracts /build/shared-contracts
COPY services/evidence-api /build/evidence-api
COPY services/edge-agent /build/edge-agent
COPY services/web-ui /build/web-ui
RUN python -m pip install --no-cache-dir \
    /build/shared-contracts \
    /build/evidence-api \
    /build/edge-agent \
    /build/web-ui \
    && rm -rf /build
USER 65532:65532
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn edge_evidence_web_ui.gateway:app --host 0.0.0.0 --port ${PORT:-8080}"]
